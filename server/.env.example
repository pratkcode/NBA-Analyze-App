# Copy this file to .env to change settings. Everything here is optional.
PORT=4000

# Python used to run the nba_api data service. Defaults to server/.venv (created by
# "npm run setup:py"), then python3.
# PYTHON=/path/to/python3

# Not used yet (planned for storing stats locally).
DATABASE_URL=postgres://user:pass@localhost:5432/nba_analytics
