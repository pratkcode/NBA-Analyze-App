# Copy this file to .env and fill in the values.
PORT=4000

# balldontlie NBA API key — sign up free at https://app.balldontlie.io
# Free tier: teams, players, games (5 requests/min).
# Season averages and league leaders need the paid GOAT tier.
BALLDONTLIE_API_KEY=

# Not used yet (planned for storing stats locally).
DATABASE_URL=postgres://user:pass@localhost:5432/nba_analytics
